# Client (public, bundled into the site)
VITE_ADMIN_EMAIL=admin@example.com

# Server only. Set these in Vercel > Project > Settings > Environment Variables. Never commit real values.
# Paystack secret key: sk_test_... for Preview, sk_live_... for Production.
PAYSTACK_SECRET_KEY=sk_test_xxx
# Firebase service account JSON, base64 encoded: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Public site URL used for the Paystack callback, no trailing slash.
APP_URL=https://jlcandmore.vercel.app
